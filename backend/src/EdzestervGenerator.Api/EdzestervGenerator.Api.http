@baseUrl = https://localhost:7001
@email = demo@example.com
@password = DemoPassword123

### Register (run once)
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{ "email": "{{email}}", "password": "{{password}}" }

### Login (cookie support required in the HTTP client)
POST {{baseUrl}}/api/auth/login?useCookies=true
Content-Type: application/json

{ "email": "{{email}}", "password": "{{password}}" }

### Current account
GET {{baseUrl}}/api/auth/manage/info

### Equipment in English
GET {{baseUrl}}/api/equipment
Accept-Language: en

### Generate plan
POST {{baseUrl}}/api/plans/generate
Content-Type: application/json
Accept-Language: hu

{
  "goal": "Hypertrophy",
  "location": "Home",
  "equipmentIds": [1, 3, 4, 5],
  "days": ["Monday", "Wednesday", "Friday"],
  "sessionMinutes": 60,
  "difficulty": "Medium"
}

### Current plan
GET {{baseUrl}}/api/plans/current

### Saved preferences
GET {{baseUrl}}/api/plans/preferences

### Exercise statistics
GET {{baseUrl}}/api/stats/exercises

### Weekly statistics
GET {{baseUrl}}/api/stats?weeks=4

### Logout
POST {{baseUrl}}/api/auth/logout
